# Copy to .env and fill in. Read by the contact form (src/utils/mail.ts), on the server only.
# Messages are sent from USER_NAME's account to TO, with the visitor's address as the reply-to.

# The mail provider, as nodemailer names it (e.g. gmail, outlook365); see nodemailer's "well-known services"
SERVICE=
# The account's address, which sends the messages
USER_NAME=
# The account's password (for Gmail: an app password, not the account's own)
PASS=
# Where messages are delivered
TO=
